{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/minyansh7/aoraforge-methodology/main/schema/polling-output.schema.json",
  "title": "AORAFORGE Polling Output",
  "type": "object",
  "required": [
    "spec_version",
    "engagement_id",
    "example_status",
    "case_study",
    "kickoff_date",
    "verification_date",
    "subject",
    "competitors",
    "platforms",
    "match_rules",
    "queries",
    "summary"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "spec_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "engagement_id": { "type": "string", "minLength": 1 },
    "example_status": {
      "type": "string",
      "enum": ["synthetic", "anonymized-real", "customer-approved-public"]
    },
    "case_study": { "type": "string", "minLength": 1 },
    "kickoff_date": { "type": "string", "format": "date" },
    "verification_date": { "type": "string", "format": "date" },
    "subject": { "type": "string", "minLength": 1 },
    "competitors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "platforms": {
      "type": "array",
      "items": { "enum": ["chatgpt", "perplexity", "google_aio", "brave"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "platform_notes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "match_rules": {
      "type": "object",
      "required": ["case_sensitive", "scope", "permitted_variations"],
      "properties": {
        "case_sensitive": { "type": "boolean" },
        "scope": { "enum": ["answer_paragraph", "full_response"] },
        "permitted_variations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "query", "intent_class", "results", "cited_at_day_45", "verdict"],
        "properties": {
          "id": { "type": "string", "pattern": "^Q\\d{2}$" },
          "query": { "type": "string", "minLength": 1 },
          "intent_class": {
            "enum": ["brand-adjacent", "buyer-intent-geo", "educational-comparison"]
          },
          "results": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["checkins", "trajectory"],
              "properties": {
                "checkins": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["day", "polls", "cited", "rate", "ci90_lower", "ci90_upper"],
                    "properties": {
                      "day": { "enum": [7, 14, 21, 30, 45, 60, 90] },
                      "polls": { "type": "integer", "minimum": 1 },
                      "cited": { "type": "integer", "minimum": 0 },
                      "rate": { "type": "number", "minimum": 0, "maximum": 1 },
                      "ci90_lower": { "type": "number", "minimum": 0, "maximum": 1 },
                      "ci90_upper": { "type": "number", "minimum": 0, "maximum": 1 }
                    },
                    "additionalProperties": false
                  }
                },
                "trajectory": {
                  "enum": ["compounding", "decaying", "lagging", "flat-zero", "spike-decay", "mixed"]
                },
                "note": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "cited_at_day_45": { "type": "boolean" },
          "verdict": { "enum": ["win", "loss", "inconclusive"] }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "queries_cited_at_day_45",
        "queries_invisible_at_day_45",
        "refund_threshold",
        "refund_triggered",
        "note"
      ],
      "properties": {
        "queries_cited_at_day_45": { "type": "integer", "minimum": 0 },
        "queries_invisible_at_day_45": { "type": "integer", "minimum": 0 },
        "refund_threshold": { "type": "integer", "minimum": 1 },
        "refund_triggered": { "type": "boolean" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
